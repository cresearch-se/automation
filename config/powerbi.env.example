# Power BI service-principal credentials for exporting the Utilization paginated report.
#
# SETUP:
#   1. Copy this file to  config/creds/powerbi.env
#   2. Fill in the three values from your dev (the Azure AD app registration).
#   config/creds/ is gitignored, so the real file with secrets is never committed.

# --- Auth only (ask your dev) ---
PBI_TENANT_ID=
PBI_CLIENT_ID=
PBI_CLIENT_SECRET=

# NOTE: the report to export is identified by its URL in
# tests/TeamworkDB/refresh_utilization_fixture.py (REPORT_URL), not here.
